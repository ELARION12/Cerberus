# Linguist overrides — ensure GitHub shows only project languages (Python, C++, C)

# Mark non-code files so Linguist ignores them in language stats
*.md linguist-documentation
*.svg linguist-documentation
*.gif linguist-documentation
*.pdf linguist-documentation
*.html linguist-documentation
requirements.txt linguist-documentation
LICENSE linguist-documentation

# Ensure CMake files are detected as CMake language
CMakeLists.txt linguist-language=CMake

# Makefile is auto-generated by CMake, not hand-written project code
Makefile linguist-detectable=false
